#!/usr/bin/env node
// One-time OAuth authorization helper.
// Opens your browser, catches the redirect on localhost:8080, exchanges the
// code for tokens, and writes them back to your whoop.env file.

const fs = require('fs');
const path = require('path');
const os = require('os');
const http = require('http');
const crypto = require('crypto');
const { exec } = require('child_process');

const ENV_FILE = process.env.WHOOP_ENV_FILE || path.join(os.homedir(), '.config/whoop-cli/whoop.env');
const REDIRECT_URI = 'http://localhost:8080/callback';
const AUTH_URL = 'https://api.prod.whoop.com/oauth/oauth2/auth';
const TOKEN_URL = 'https://api.prod.whoop.com/oauth/oauth2/token';
const SCOPES = [
  'read:recovery',
  'read:sleep',
  'read:cycles',
  'read:workout',
  'read:profile',
  'read:body_measurement',
  'offline',
].join(' ');

function loadEnv() {
  if (!fs.existsSync(ENV_FILE)) {
    console.error(`Env file not found: ${ENV_FILE}`);
    console.error('Copy whoop.env.example to that path and fill in WHOOP_CLIENT_ID and WHOOP_CLIENT_SECRET first.');
    process.exit(1);
  }
  const env = {};
  for (const line of fs.readFileSync(ENV_FILE, 'utf8').split('\n')) {
    const t = line.trim();
    if (!t || t.startsWith('#')) continue;
    const i = t.indexOf('=');
    if (i === -1) continue;
    let v = t.slice(i + 1).trim();
    if ((v.startsWith('"') && v.endsWith('"')) || (v.startsWith("'") && v.endsWith("'"))) {
      v = v.slice(1, -1);
    }
    env[t.slice(0, i).trim()] = v;
  }
  return env;
}

function saveTokens(accessToken, refreshToken) {
  let content = fs.readFileSync(ENV_FILE, 'utf8');
  const upsert = (key, val) => {
    const re = new RegExp(`^${key}=.*$`, 'm');
    const line = `${key}="${val}"`;
    content = re.test(content) ? content.replace(re, line) : content + `\n${line}\n`;
  };
  upsert('WHOOP_ACCESS_TOKEN', accessToken);
  upsert('WHOOP_REFRESH_TOKEN', refreshToken);
  fs.writeFileSync(ENV_FILE, content);
}

function openBrowser(url) {
  const cmd = process.platform === 'darwin' ? 'open'
            : process.platform === 'win32' ? 'start ""'
            : 'xdg-open';
  exec(`${cmd} "${url}"`, () => {});
}

async function exchangeCode(env, code) {
  const params = new URLSearchParams({
    grant_type: 'authorization_code',
    code,
    redirect_uri: REDIRECT_URI,
    client_id: env.WHOOP_CLIENT_ID,
    client_secret: env.WHOOP_CLIENT_SECRET,
  });
  const res = await fetch(TOKEN_URL, {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: params.toString(),
  });
  const data = await res.json();
  if (!data.access_token) throw new Error(`Token exchange failed: ${JSON.stringify(data)}`);
  return data;
}

async function main() {
  const env = loadEnv();
  if (!env.WHOOP_CLIENT_ID || !env.WHOOP_CLIENT_SECRET) {
    console.error('WHOOP_CLIENT_ID and WHOOP_CLIENT_SECRET must be set in ' + ENV_FILE);
    process.exit(1);
  }

  const state = crypto.randomBytes(16).toString('hex');
  const authUrl = `${AUTH_URL}?` + new URLSearchParams({
    response_type: 'code',
    client_id: env.WHOOP_CLIENT_ID,
    redirect_uri: REDIRECT_URI,
    scope: SCOPES,
    state,
  }).toString();

  console.log('Opening browser to authorize Whoop access...');
  console.log('If the browser does not open, visit this URL manually:\n');
  console.log(authUrl + '\n');

  const server = http.createServer(async (req, res) => {
    const url = new URL(req.url, 'http://localhost:8080');
    if (url.pathname !== '/callback') {
      res.writeHead(404); res.end('Not found'); return;
    }
    const code = url.searchParams.get('code');
    const returnedState = url.searchParams.get('state');
    if (!code || returnedState !== state) {
      res.writeHead(400, { 'Content-Type': 'text/plain' });
      res.end('Authorization failed: missing code or state mismatch.');
      server.close();
      process.exit(1);
    }
    try {
      const tokens = await exchangeCode(env, code);
      saveTokens(tokens.access_token, tokens.refresh_token);
      res.writeHead(200, { 'Content-Type': 'text/html' });
      res.end('<html><body style="font-family:system-ui;padding:40px;max-width:480px"><h2>Authorized.</h2><p>Tokens written to <code>' + ENV_FILE + '</code>. You can close this tab and return to your terminal.</p></body></html>');
      console.log('\n✓ Authorization complete.');
      console.log(`  Tokens saved to ${ENV_FILE}`);
      console.log('  Try it: whoop summary');
      server.close();
      setTimeout(() => process.exit(0), 100);
    } catch (e) {
      res.writeHead(500, { 'Content-Type': 'text/plain' });
      res.end(`Token exchange failed: ${e.message}`);
      server.close();
      process.exit(1);
    }
  });

  server.listen(8080, () => {
    openBrowser(authUrl);
    console.log('Listening on http://localhost:8080/callback');
    console.log('Waiting for you to authorize in the browser...');
  });
}

main().catch(e => { console.error(e); process.exit(1); });
